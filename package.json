{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:import-sample": "tsx scripts/test-thor-sample-import.mts",
    "test:smart-import": "tsx scripts/test-smart-import.mts",
    "test:dealer-portal": "tsx scripts/test-dealer-portal.mts",
    "test:dealer-profile": "tsx scripts/test-dealer-profile.mts",
    "test:dealer-profile-browser": "tsx scripts/test-dealer-profile-browser.mts",
    "test:dealer-deeplink": "tsx scripts/test-dealer-deeplink.mts",
    "test:dealer-import-smoke": "tsx scripts/test-dealer-import-smoke.mts",
    "test:duplicate-detection": "tsx scripts/test-duplicate-detection.mts",
    "test:listing-images": "tsx scripts/test-listing-image-mapping.mts",
    "test:my-listings": "tsx scripts/test-my-listings.mts",
    "test:friendly-errors": "tsx scripts/test-friendly-api-errors.mts",
    "test:payload-too-large": "tsx scripts/test-payload-too-large.mts",
    "test:listing-description-format": "tsx scripts/test-listing-description-format.mts",
    "test:edit-listing-images": "tsx scripts/test-edit-listing-images.mts",
    "test:marketplace-image-priority": "tsx scripts/test-marketplace-image-priority.mts",
    "test:smoke-http": "tsx scripts/smoke-http.mts",
    "test": "npm run test:listing-images && npm run test:marketplace-image-priority && npm run test:friendly-errors && npm run test:payload-too-large && npm run test:listing-description-format && npm run test:edit-listing-images && npm run test:my-listings && npm run test:smart-import && npm run test:dealer-portal && npm run test:duplicate-detection && npm run test:import-sample"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.100.11",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.13.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
