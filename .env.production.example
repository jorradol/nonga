# Copy to .env.production (gitignored) for production Cloud Run / hosting builds.
# Values: Firebase Console > Project settings > Your apps > Web app SDK config.
# Do not commit real values. Wire secrets via Secret Manager / Cloud Run env only.

# --- Firebase Web (client bundle) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Public signup must stay closed unless explicitly approved for production pilot.
VITE_NONGA_PUBLIC_SIGNUP_ENABLED=false

# Production: leave browser API token placeholders empty — use Firebase Auth ID tokens.
VITE_NONGA_DEALER_API_TOKEN=
VITE_NONGA_ADMIN_API_TOKEN=

# --- Server runtime (Cloud Run) ---
NODE_ENV=production
APP_URL=
PORT=8080

# Data / image backends — set per production migration phase.
NONGA_DATA_BACKEND=
NONGA_IMAGE_BACKEND=

# Server-side API auth — prefer Firebase Admin ID token verification; never commit tokens.
NONGA_DEALER_API_TOKEN=
NONGA_ADMIN_API_TOKEN=

# CORS — comma-separated allowed browser origins (no trailing slashes).
# Example: https://nonga-car.com,https://nonga-ce93c.web.app
CORS_ALLOWED_ORIGINS=

# Gemini / AI — configure via Secret Manager; leave empty until production pilot approval.
GEMINI_API_KEY=

# Firebase Admin SDK — use exactly one credential path; never commit real values.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# v5.4.4e AI abuse guard (review before enabling in production)
# NONGA_AI_GUEST_DISABLED=
# NONGA_AI_EMERGENCY_LOCKDOWN=
# NONGA_AI_RL_GUEST_SHORT_MAX=
# NONGA_AI_RL_GUEST_DAILY_MAX=
# NONGA_AI_RL_USER_SHORT_MAX=
# NONGA_AI_RL_USER_DAILY_MAX=

# v6.8B Sales Brain / Gemini safety — production defaults must remain fail-closed.
# NONGA_AI_PROVIDER=
# NONGA_AI_MODE=
# NONGA_AI_FIRST_ENABLED=
# NONGA_AI_SHADOW_MODE_ENABLED=
# NONGA_AI_USER_VISIBLE_ENABLED=
# NONGA_AI_EMERGENCY_KILL_SWITCH=
# NONGA_AI_BUDGET_DAILY_LIMIT=
# NONGA_AI_BUDGET_MONTHLY_LIMIT=
# NONGA_AI_USER_VISIBLE_ALLOWLIST_UIDS=
# NONGA_AI_USER_VISIBLE_REAL_PROVIDER_ENABLED=
# NONGA_AI_ADMIN_SHADOW_REAL_PROVIDER_ENABLED=
# NONGA_AI_CHAT_SHADOW_REAL_PROVIDER_ENABLED=

# Lead capture — enable only after controlled production pilot approval.
# NONGA_LEAD_CAPTURE_ENABLED=
# NONGA_LEAD_DATA_BACKEND=
# NONGA_LEAD_PILOT_MAX_CREATED=
# NONGA_LEAD_PILOT_EXPIRES_AT=

# Production must NOT use local dev maps — leave empty.
NONGA_DEV_FIREBASE_TOKEN_MAP=
NONGA_DEV_USER_PROFILE_MAP=
NONGA_DEV_DEALER_MEMBERSHIP_MAP=
NONGA_TEST_MEMBER_UID=
NONGA_TEST_MEMBER_EMAIL=
NONGA_TEST_DEALER_UID=
NONGA_TEST_DEALER_EMAIL=
NONGA_TEST_ADMIN_UID=
NONGA_TEST_ADMIN_EMAIL=

# Staging-only owner helpers — must remain disabled in production.
VITE_NONGA_OWNER_FIREBASE_TOKEN_HELPER_ENABLED=false
VITE_NONGA_OWNER_GEMINI_ONE_RUN_HELPER_ENABLED=false
VITE_NONGA_BUYER_FRIENDLY_COPY_PREVIEW_ENABLED=false
VITE_NONGA_BUYER_FRIENDLY_COPY_PREVIEW_ALLOWLIST_UIDS=
