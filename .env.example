GEMINI_API_KEY=""
APP_URL="http://localhost:3000"

# Data backend.
# file is the safe default for local/dev and current smoke tests.
# firestore is prepared for staging after data/image migration steps are complete.
NONGA_DATA_BACKEND="file"

# Image backend.
# file keeps using data/listing-images and /storage/listings for local/dev.
# firebase-storage is prepared for staging after image migration is complete.
NONGA_IMAGE_BACKEND="file"

# Local DEV / beta API auth placeholders.
# Do not use these in production; prefer Firebase Auth ID tokens for real staging.
NONGA_DEALER_API_TOKEN="your-dealer-api-token"
NONGA_ADMIN_API_TOKEN="your-admin-api-token"

# DEV/mock-only browser token placeholders. Leave blank for real Firebase Auth mode.
VITE_NONGA_DEALER_API_TOKEN=""
VITE_NONGA_ADMIN_API_TOKEN=""

# Firebase Web Auth config.
# Copy these from Firebase Console > Project settings > General > Your apps > Web app SDK setup.
# Leave blank for local mock mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_NONGA_PUBLIC_SIGNUP_ENABLED=false

# Keep public signup closed unless you intentionally allow it.
VITE_NONGA_PUBLIC_SIGNUP_ENABLED="false"

# v5.4.4e AI abuse guard (read-only switches; do not enable in production without review)
# NONGA_AI_GUEST_DISABLED=false
# NONGA_AI_EMERGENCY_LOCKDOWN=false
# NONGA_AI_RL_GUEST_SHORT_MAX=12
# NONGA_AI_RL_GUEST_DAILY_MAX=60
# NONGA_AI_RL_USER_SHORT_MAX=30
# NONGA_AI_RL_USER_DAILY_MAX=200

# v6.8B — Sales Brain / Gemini safety (staging operator template — no secrets)
# Legacy Gemini SDK routes respect NONGA_AI_EMERGENCY_KILL_SWITCH=true (mock/fail-closed).
# GEMINI_API_KEY=""                    # leave empty locally to avoid paid API calls
# NONGA_AI_PROVIDER=gemini             # required for shadow/user-visible prerequisites
# NONGA_AI_MODE=high                   # off | low | standard | high
# NONGA_AI_FIRST_ENABLED=true
# NONGA_AI_SHADOW_MODE_ENABLED=false   # true only after staging shadow approval
# NONGA_AI_USER_VISIBLE_ENABLED=false  # true only for controlled allowlist pilot
# NONGA_AI_EMERGENCY_KILL_SWITCH=false # true = block legacy Gemini + Sales Brain paths
# NONGA_AI_BUDGET_DAILY_LIMIT=5        # prerequisite gate (not consumption tracking)
# NONGA_AI_BUDGET_MONTHLY_LIMIT=50
# NONGA_AI_USER_VISIBLE_ALLOWLIST_UIDS=  # comma-separated Firebase UIDs (server only)
# NONGA_AI_ADMIN_SHADOW_REAL_PROVIDER_ENABLED=false
# NONGA_AI_CHAT_SHADOW_REAL_PROVIDER_ENABLED=false

# Backend Firebase Admin verification.
# Use exactly one credential path in staging/production; never commit real values.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_SERVICE_ACCOUNT_JSON=""
GOOGLE_APPLICATION_CREDENTIALS=""

# Limited beta dealer binding, if not using full Firebase dealer membership yet.
NONGA_BETA_DEALER_ID=""
NONGA_DEALER_TOKEN_MAP=""

# Local-only Firebase auth smoke maps. Production ignores these.
NONGA_DEV_FIREBASE_TOKEN_MAP=""
NONGA_DEV_USER_PROFILE_MAP=""
NONGA_DEV_DEALER_MEMBERSHIP_MAP=""

# Limited real Firebase role test seeding.
# Create Firebase Auth users first, then paste their UIDs here. Never store passwords in env.
NONGA_TEST_MEMBER_UID=""
NONGA_TEST_MEMBER_EMAIL=""
NONGA_TEST_MEMBER_DISPLAY_NAME="Nong A Test Member"
NONGA_TEST_DEALER_UID=""
NONGA_TEST_DEALER_EMAIL=""
NONGA_TEST_DEALER_DISPLAY_NAME="Nong A Test Dealer"
NONGA_TEST_DEALER_ID="thor-auto"
NONGA_TEST_DEALER_NAME="Thor Auto Demo"
NONGA_TEST_ADMIN_UID=""
NONGA_TEST_ADMIN_EMAIL=""
NONGA_TEST_ADMIN_DISPLAY_NAME="Nong A Test Admin"
NONGA_TEST_ADMIN_ROLE="admin"
