# Hosting-only UI fixture build (Gate D1)
# Copy to .env.hosting-only-fixture (gitignored) only if you need local overrides.
# The build script sets required values itself — do not point at Production.

VITE_NONGA_UI_FIXTURE=true
VITE_NONGA_PUBLIC_BASE_URL=https://nonga-staging-2026.web.app
NONGA_HOSTING_ONLY_FIXTURE_PROJECT_ID=nonga-staging-2026
NONGA_HOSTING_ONLY_FIXTURE_HOSTING_SITE=nonga-staging-2026
NONGA_HOSTING_ONLY_FIXTURE_PUBLIC_URL=https://nonga-staging-2026.web.app

# Must remain blank / false — no Firebase Auth / API tokens in fixture builds
VITE_NONGA_PUBLIC_SIGNUP_ENABLED=false
VITE_NONGA_DEALER_API_TOKEN=
VITE_NONGA_ADMIN_API_TOKEN=
VITE_NONGA_OWNER_FIREBASE_TOKEN_HELPER_ENABLED=false
VITE_NONGA_OWNER_GEMINI_ONE_RUN_HELPER_ENABLED=false
VITE_NONGA_BUYER_FRIENDLY_COPY_PREVIEW_ENABLED=false
