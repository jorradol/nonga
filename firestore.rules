rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function myProfileExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myProfile() {
      return userDoc(request.auth.uid);
    }

    function isActiveUser() {
      return myProfileExists() && myProfile().status == "active";
    }

    function hasActiveRole(roles) {
      return isActiveUser() && myProfile().role in roles;
    }

    function isActiveAdmin() {
      return hasActiveRole(["admin", "superadmin"]);
    }

    function isSuperAdmin() {
      return hasActiveRole(["superadmin"]);
    }

    function membershipId(uid, dealerId) {
      return uid + "_" + dealerId;
    }

    function dealerMemberDoc(uid, dealerId) {
      return get(/databases/$(database)/documents/dealerMembers/$(membershipId(uid, dealerId))).data;
    }

    function hasDealerMembership(dealerId) {
      return signedIn()
        && dealerId is string
        && exists(/databases/$(database)/documents/dealerMembers/$(membershipId(request.auth.uid, dealerId)));
    }

    function hasActiveDealerMembership(dealerId) {
      return isActiveUser()
        && dealerId is string
        && exists(/databases/$(database)/documents/dealerMembers/$(membershipId(request.auth.uid, dealerId)))
        && dealerMemberDoc(request.auth.uid, dealerId).status == "active";
    }

    function isDealerOwner(dealerId) {
      return hasActiveDealerMembership(dealerId)
        && dealerMemberDoc(request.auth.uid, dealerId).roleInDealer == "owner";
    }

    function safeUserSelfUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "role",
        "status",
        "dealerId",
        "dealerName",
        "createdAt",
        "uid"
      ]);
    }

    function sameDealerId() {
      return request.resource.data.dealerId == resource.data.dealerId;
    }

    function publishedListing(data) {
      return data.listingStatus == "published"
        || data.status == "approved"
        || data.status == "published";
    }

    function canReadDealerScoped(data) {
      return isActiveAdmin()
        || (data.dealerId is string && hasActiveDealerMembership(data.dealerId));
    }

    function canCreateDealerScoped(data) {
      return isActiveAdmin()
        || (data.dealerId is string && hasActiveDealerMembership(data.dealerId));
    }

    function canUpdateDealerScoped() {
      return isActiveAdmin()
        || (
          resource.data.dealerId is string
          && sameDealerId()
          && hasActiveDealerMembership(resource.data.dealerId)
        );
    }

    function canDeleteDealerScoped() {
      return isActiveAdmin()
        || (
          resource.data.dealerId is string
          && hasActiveDealerMembership(resource.data.dealerId)
        );
    }

    function canReadChatSession(data) {
      return isActiveAdmin()
        || (
          data.scope == "user"
          && data.uid == request.auth.uid
        )
        || (
          data.scope == "dealer"
          && data.dealerId is string
          && hasActiveDealerMembership(data.dealerId)
        );
    }

    function canCreateChatSession(data) {
      return isActiveAdmin()
        || (
          data.scope == "user"
          && data.uid == request.auth.uid
          && !(data.keys().hasAny(["dealerId"]) && data.dealerId != null)
        )
        || (
          data.scope == "dealer"
          && data.uid == request.auth.uid
          && data.dealerId is string
          && hasActiveDealerMembership(data.dealerId)
        );
    }

    function canUpdateChatSession() {
      return canReadChatSession(resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.scope == resource.data.scope
        && request.resource.data.dealerId == resource.data.dealerId;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isActiveAdmin());
      allow create: if false;
      allow update: if signedIn()
        && (
          isSuperAdmin()
          || (
            isActiveAdmin()
            && !(
              resource.data.role in ["admin", "superadmin"]
              || request.resource.data.role in ["admin", "superadmin"]
            )
          )
          || (request.auth.uid == uid && isActiveUser() && safeUserSelfUpdate())
        );
      allow delete: if isSuperAdmin();
    }

    match /dealerMembers/{membershipId} {
      allow read: if signedIn()
        && (
          resource.data.uid == request.auth.uid
          || isDealerOwner(resource.data.dealerId)
          || isActiveAdmin()
        );
      allow create, update: if isActiveAdmin();
      allow delete: if isSuperAdmin();
    }

    // Current client-side Firestore listing collection used by src/services/cars.
    match /cars/{listingId} {
      allow read: if publishedListing(resource.data) || canReadDealerScoped(resource.data);
      allow create: if canCreateDealerScoped(request.resource.data);
      allow update: if canUpdateDealerScoped();
      allow delete: if canDeleteDealerScoped();
    }

    // Production projection for server-side marketplace inventory.
    match /dealerListings/{listingId} {
      allow read: if publishedListing(resource.data) || canReadDealerScoped(resource.data);
      allow create: if canCreateDealerScoped(request.resource.data);
      allow update: if canUpdateDealerScoped();
      allow delete: if canDeleteDealerScoped();
    }

    // Production projection for server-side dealer draft inventory.
    match /dealerDrafts/{draftId} {
      allow read: if canReadDealerScoped(resource.data);
      allow create: if canCreateDealerScoped(request.resource.data);
      allow update: if canUpdateDealerScoped();
      allow delete: if canDeleteDealerScoped();
    }

    // Metadata for listing/draft/chat images. Binary files belong in Storage.
    match /listingImages/{imageId} {
      allow read: if resource.data.visibility == "public"
        || publishedListing(resource.data)
        || canReadDealerScoped(resource.data);
      allow create: if canCreateDealerScoped(request.resource.data);
      allow update: if canUpdateDealerScoped();
      allow delete: if canDeleteDealerScoped();
    }

    // Production chat history schema used from Step 2L onward.
    match /chatSessions/{sessionId} {
      allow read: if signedIn() && canReadChatSession(resource.data);
      allow create: if signedIn()
        && request.resource.data.sessionId == sessionId
        && request.resource.data.status == "active"
        && canCreateChatSession(request.resource.data);
      allow update: if signedIn() && canUpdateChatSession();
      allow delete: if signedIn() && canReadChatSession(resource.data);

      match /messages/{messageId} {
        allow read: if signedIn()
          && canReadChatSession(get(/databases/$(database)/documents/chatSessions/$(sessionId)).data);
        allow create: if signedIn()
          && request.resource.data.messageId == messageId
          && canReadChatSession(get(/databases/$(database)/documents/chatSessions/$(sessionId)).data);
        allow update, delete: if false;
      }
    }

    // Legacy pre-Step-2L chat collection. Keep read-only for migration/export, not new writes.
    match /chats/{chatId} {
      allow read: if signedIn() && canReadChatSession(resource.data);
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && canReadChatSession(get(/databases/$(database)/documents/chats/$(chatId)).data);
        allow create, update, delete: if false;
      }
    }

    function isOwnUserAiPrefScope(scopeKey) {
      return scopeKey == "user:" + request.auth.uid;
    }

    function isOwnDealerAiPrefScope(scopeKey, dealerId) {
      return dealerId is string
        && scopeKey == "dealer:" + dealerId + ":" + request.auth.uid;
    }

    function canReadAiPreferences(scopeKey) {
      return isActiveUser()
        && (
          isActiveAdmin()
          || isOwnUserAiPrefScope(scopeKey)
          || (
            resource.data.dealerId is string
            && isOwnDealerAiPrefScope(scopeKey, resource.data.dealerId)
            && hasActiveDealerMembership(resource.data.dealerId)
          )
        );
    }

    function canWriteAiPreferences(scopeKey) {
      return isActiveUser()
        && (
          isActiveAdmin()
          || isOwnUserAiPrefScope(scopeKey)
          || (
            request.resource.data.dealerId is string
            && isOwnDealerAiPrefScope(scopeKey, request.resource.data.dealerId)
            && hasActiveDealerMembership(request.resource.data.dealerId)
          )
        );
    }

    match /ai_preferences/{scopeKey} {
      allow read: if canReadAiPreferences(scopeKey);
      allow create, update: if canWriteAiPreferences(scopeKey);
      allow delete: if isActiveAdmin() || isSuperAdmin();
    }

    // v5.6I.5 / v5.6I.6 — Settlement / success fee: server-only via Cloud Run Admin SDK.
    // All roles denied direct client read/write; financial data via API only (redacted).
    match /successFeeRecords/{recordId} {
      allow read, write: if false;
    }

    match /successFeeRecords/{recordId}/{document=**} {
      allow read, write: if false;
    }

    match /settlementAdjustments/{adjustmentId} {
      allow read, write: if false;
    }

    match /settlementAdjustments/{adjustmentId}/{document=**} {
      allow read, write: if false;
    }

    match /settlementAuditLogs/{auditLogId} {
      allow read, write: if false;
    }

    match /settlementAuditLogs/{auditLogId}/{document=**} {
      allow read, write: if false;
    }

    // v5.6I.10 — Durable settlement idempotency records: Admin SDK only (cross-instance dedupe).
    match /settlementIdempotencyRecords/{recordId} {
      allow read, write: if false;
    }

    match /settlementIdempotencyRecords/{recordId}/{document=**} {
      allow read, write: if false;
    }

    // v5.6F.2 — AI Sales Lead Engine (phase 1): server-only via Cloud Run Admin SDK.
    // Client direct read/write denied; masked queue and PII via API only.
    match /buyerLeads/{leadId} {
      allow read, write: if false;
    }

    match /leadContactLogs/{logId} {
      allow read, write: if false;
    }

    // v22.52 — Durable buyer-lead active-slot idempotency: Admin SDK only.
    match /buyerLeadIdempotencyRecords/{recordId} {
      allow read, write: if false;
    }

    match /buyerLeadIdempotencyRecords/{recordId}/{document=**} {
      allow read, write: if false;
    }

    match /buyerPurchaseProfiles/{buyerUserId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
