{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account document documenting subscription tier, role, and custom car limits in Firestore.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique identifier matching Firebase Auth UID." },
        "displayName": { "type": "string", "description": "Display user name." },
        "email": { "type": "string", "description": "Verified user email address." },
        "photoURL": { "type": "string", "description": "URL of user high-contrast avatar illustration." },
        "role": { "type": "string", "enum": ["guest", "member", "dealer", "premium", "admin", "superadmin"], "description": "Role-Based Access Control tier." },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLogin": { "type": "string", "format": "date-time" },
        "favoriteCars": { "type": "array", "description": "Array of bookmarked car IDs." },
        "aiPersona": { "type": "string", "description": "Preferred AI salesperson persona, e.g., Energetic, Tech Savvy, Professional." },
        "membershipType": { "type": "string", "enum": ["free", "pro", "dealer", "enterprise"], "description": "Billing plan identifier." },
        "postLimit": { "type": "integer", "description": "Total allowable car posts." },
        "totalPosts": { "type": "integer", "description": "Currently posted cars counter." },
        "premiumExpireDate": { "type": "string", "format": "date-time", "description": "Expiry check for premium limits." }
      },
      "required": ["uid", "displayName", "email", "role", "createdAt", "lastLogin", "favoriteCars", "membershipType", "postLimit", "totalPosts"]
    },
    "UserSettings": {
      "title": "User Settings",
      "description": "Personalized portal preferences, notification toggles, and layout styles.",
      "type": "object",
      "properties": {
        "theme": { "type": "string", "enum": ["light", "dark", "system"] },
        "emailNotifications": { "type": "boolean" },
        "pushNotifications": { "type": "boolean" },
        "language": { "type": "string", "enum": ["th", "en"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["theme", "emailNotifications"]
    },
    "UserSession": {
      "title": "User Session Log",
      "description": "Session tracking for audit trails, geography checks, and credential validation.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "loginTime": { "type": "string", "format": "date-time" },
        "ipAddress": { "type": "string" },
        "device": { "type": "string" },
        "browser": { "type": "string" }
      },
      "required": ["userId", "loginTime"]
    },
    "AiPreferences": {
      "title": "AI Preferences",
      "description": "Smart customization criteria for tailored AI reports from Nong A.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "preferredBrands": { "type": "array" },
        "aiResponseLength": { "type": "string", "enum": ["short", "medium", "conversational"] },
        "focusArea": { "type": "string", "enum": ["ev", "luxury", "general", "performance"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "aiResponseLength", "focusArea"]
    },
    "CarListing": {
      "title": "Car Listing",
      "description": "A comprehensive vehicle listing in the marketplace, supporting standard, EV, and luxury segments.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier of the car listing." },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "brand": { "type": "string" },
        "model": { "type": "string" },
        "year": { "type": "integer" },
        "generation": { "type": "string" },
        "bodyType": { "type": "string" },
        "transmission": { "type": "string", "enum": ["auto", "manual", "other"] },
        "fuelType": { "type": "string", "enum": ["petrol", "diesel", "electric", "hybrid", "plug-in-hybrid", "other"] },
        "mileage": { "type": "number" },
        "color": { "type": "string" },
        "engineSize": { "type": "string" },
        "drivetrain": { "type": "string" },
        "condition": { "type": "string", "enum": ["new", "used", "excellent", "good", "fair"] },
        "price": { "type": "number" },
        "negotiable": { "type": "boolean" },
        "province": { "type": "string" },
        "description": { "type": "string" },
        "features": { "type": "array" },
        "tags": { "type": "array" },
        "coverImage": { "type": "string" },
        "gallery": { "type": "array" },
        "sellerId": { "type": "string" },
        "sellerType": { "type": "string", "enum": ["private", "dealer", "agent"] },
        "dealerId": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "pending", "approved", "rejected", "archived"] },
        "featured": { "type": "boolean" },
        "boosted": { "type": "boolean" },
        "aiGenerated": { "type": "boolean" },
        "aiScore": { "type": "number" },
        "aiAnalysis": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "totalViews": { "type": "integer" },
        "totalFavorites": { "type": "integer" }
      },
      "required": ["title", "slug", "brand", "model", "year", "price", "bodyType", "transmission", "fuelType", "mileage", "color", "condition", "province", "description", "sellerId", "sellerType", "status"]
    },
    "CarImage": {
      "title": "Car Image Asset Reference",
      "description": "Image gallery references for vehicle listings.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "carId": { "type": "string" },
        "url": { "type": "string" },
        "isCover": { "type": "boolean" },
        "uploadedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["carId", "url", "isCover", "uploadedBy"]
    },
    "CarBrand": {
      "title": "Manufacturer Brand",
      "description": "Vehicle brand metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "logoUrl": { "type": "string" },
        "country": { "type": "string" },
        "establishedYear": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "slug"]
    },
    "CarModel": {
      "title": "Vehicle Model",
      "description": "Vehicle model metadata relating back to brands.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "brandId": { "type": "string" },
        "brandName": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "bodyType": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["brandId", "brandName", "name", "slug"]
    },
    "CarView": {
      "title": "Car Page View Log",
      "description": "Individually tracked views of vehicle postings.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "carId": { "type": "string" },
        "userId": { "type": "string" },
        "ipAddress": { "type": "string" },
        "userAgent": { "type": "string" },
        "viewedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["carId", "viewedAt"]
    },
    "CarFavorite": {
      "title": "Car Bookmark/Favorite Connection",
