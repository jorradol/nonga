        "id": { "type": "string" },
        "userId": { "type": "string" },
        "carId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "carId"]
    },
    "Dealer": {
      "title": "Dealer Showroom",
      "description": "Showroom of certified car dealers.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "userId": { "type": "string" },
        "logoUrl": { "type": "string" },
