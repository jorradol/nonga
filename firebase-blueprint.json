  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Primary user profile collection containing identity and subscription details."
    },
    "user_settings/{userId}": {
      "schema": "UserSettings",
      "description": "Preference-level document corresponding to each user configuration."
    },
    "user_sessions/{sessionId}": {
      "schema": "UserSession",
      "description": "Individual login session logger files."
    },
    "ai_preferences/{userId}": {
      "schema": "AiPreferences",
      "description": "Custom fine-tune directives for smart report generations by Nong A."
    },
    "cars/{carId}": {
      "schema": "CarListing",
